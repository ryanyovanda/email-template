APP_NAME=ApplyMail
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true wherever the app is served over https, and false here: a secure
# cookie is not sent back over plain http, and every login fails silently.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- DeepSeek (AI drafting) -------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Seconds a single generation may run for. Designing a whole template is the
# slow one; the request holds a worker for the whole time.
DEEPSEEK_TIMEOUT=120

# --- Cloudinary (photos and CV files) ---------------------------------------
# CLOUDINARY_API_KEY is the numeric key from your Cloudinary dashboard.
# Without all three set, uploads fall back to local disk storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=email-cv

# --- AI quotas --------------------------------------------------------------
AI_RATE_LIMIT_PER_MINUTE=3
AI_ABUSE_THRESHOLD_PER_DAY=20

# --- Credits ---------------------------------------------------------------
# What each AI service costs, and the allowance every account is topped up to at
# the start of a calendar month.
CREDIT_PRICE_APPLICATION_DRAFT=10
CREDIT_PRICE_TEMPLATE_DESIGN=30
CREDIT_MONTHLY_GRANT=300
# Paid to the author when an admin publishes their design to the shared library.
CREDIT_PROMOTION_REWARD=50

# --- Passkeys ---------------------------------------------------------------
# User handles are derived from this. Left unset it falls back to APP_KEY, which
# is fine until you rotate APP_KEY — that would orphan every registered passkey.
# Uncomment and set any long random string if rotation is ever on the cards.
#
# Keep it commented rather than blank: an empty value in .env is an empty string,
# not "unset", so it would replace the APP_KEY fallback with nothing.
# PASSKEYS_USER_HANDLE_SECRET=

# --- Seeded admin account ---------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=password
