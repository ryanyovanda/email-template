# =============================================================================
# Deployment environment for compose.yaml.
#
#   cp deploy.env.example deploy.env
#   # fill in everything under "Required"
#   docker compose --env-file deploy.env up -d
#
# This is NOT Laravel's .env — it only feeds ${...} substitutions in
# compose.yaml, which then become the container's environment. Always pass
# --env-file: without it Compose reads ./.env, the development environment
# file, and deploys with its APP_KEY and APP_URL.
#
# Keep this file out of version control once filled in; deploy.env is ignored.
# =============================================================================

# Leaving a required value blank does not break the stack's *deployment* — the
# app container starts, refuses to serve, and names what is missing in its logs.
#
# --- Required ---------------------------------------------------------------

# The image to run. A published one:
#   ghcr.io/<you>/<repo>:latest
# ...or any local tag when building with compose.build.yaml:
APP_IMAGE=applymail:local

# Generate once, and never change it afterwards — it decrypts existing columns:
#   docker run --rm applymail:local php artisan key:generate --show
APP_KEY=

# The public https:// address. Password-reset and verification links are built
# from this, so localhost here means broken links in real email.
APP_URL=https://apply.example.com

# Database credentials. Both are consumed by MySQL on first boot only: changing
# them later does not change the existing user, it just breaks the connection.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# SMTP. Password resets fail without it; see DEPLOY.md section 6.
MAIL_HOST=
MAIL_FROM_ADDRESS=

# The administrator account created on first boot. Change the password after
# the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# --- Recommended ------------------------------------------------------------

APP_NAME=ApplyMail

# Host port the reverse proxy forwards to. Do not expose this to the internet.
APP_PORT=8080

# AI drafting and template design. Without a key both fail with a clear
# message, and everything that does not need AI keeps working.
DEEPSEEK_API_KEY=

# Uploads. All three or none — miss one and files fall back to the local
# volume, which recruiters' email clients cannot load photos from.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=email-cv

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SCHEME=tls

# --- Optional ---------------------------------------------------------------

# DB_DATABASE=applymail
# DB_USERNAME=applymail

# Credits: what each AI service costs and the monthly allowance. Writing a
# template by hand is always free and is not priced here.
# CREDIT_MONTHLY_GRANT=300
# CREDIT_PRICE_APPLICATION_DRAFT=10
# CREDIT_PRICE_TEMPLATE_DESIGN=30
# CREDIT_PROMOTION_REWARD=50

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_RATE_LIMIT_PER_MINUTE=3
# AI_ABUSE_THRESHOLD_PER_DAY=20
# DEEPSEEK_MODEL=deepseek-chat
# Seconds one generation may hold a worker for. Lower it if slow calls are
# starving ordinary page loads.
# DEEPSEEK_TIMEOUT=120

# Set once if you ever intend to rotate APP_KEY: passkeys are derived from this,
# and it defaults to APP_KEY. Any long random string.
# PASSKEYS_USER_HANDLE_SECRET=

# debug while bringing the stack up, warning once it is serving.
# LOG_LEVEL=warning

# Only for smoke-testing over plain http://. Leave it out in production — the
# session cookie will not be sent back over http while this is true.
# SESSION_SECURE_COOKIE=false

# Nothing is queued or scheduled today; flip these if that changes.
# RUN_QUEUE_WORKER=false
# RUN_SCHEDULER=false
